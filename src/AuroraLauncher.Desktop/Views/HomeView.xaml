<UserControl x:Class="AuroraLauncher.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======== Hero（round-81：去掉大色块，文字直接站在背景上） ======== -->
        <Grid Grid.Row="0" Margin="4,6,4,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="欢迎使用 Aurora Launcher" FontSize="32" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock FontSize="13.5" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="当前实例："/>
                    <Run Text="{Binding SelectedInstanceNameText, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="  ·  账户："/>
                    <Run Text="{Binding SelectedAccountNameText, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Text="选择账户与实例，一键启动 Minecraft。" FontSize="12.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <!-- 主按钮 + 氛围光晕（用径向渐变矩形代替 DropShadowEffect：零特效开销） -->
            <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0">
                <Rectangle Width="230" Height="76" RadiusX="38" RadiusY="38" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#4D7C6AF8" Offset="0"/>
                            <GradientStop Color="#1F7C6AF8" Offset="0.6"/>
                            <GradientStop Color="#007C6AF8" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Button Content="{Binding LaunchButtonText}" Command="{Binding LaunchCommand}"
                        FontSize="15" Padding="30,13"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInstances}" Value="False">
                                    <Setter Property="ToolTip" Value="还没有实例：点了会带你到「游戏下载」创建"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>

        <!-- ======== Cards ========
             Round-91: 1280×720 / 全屏 + 缩放时，卡片区比窗口高，底部性能卡被裁掉且
             没有滚动条。包一层 ScrollViewer：内容高出视口时可滚动，窗口够高时
             MinHeight（由代码后置跟随 ViewportHeight）让两张卡继续撑满。
             HorizontalScrollBarVisibility=Disabled：卡片是自适应宽度，不该横向滚。 -->
        <ScrollViewer Grid.Row="1" x:Name="HomeScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0"
                      Focusable="False">
            <Grid x:Name="CardArea" MinHeight="{Binding ActualHeight, ElementName=HomeScroller}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Accounts -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0">
                <StackPanel>
                    <TextBlock Text="账户" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Type, StringFormat='  ({0})'}" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="添加离线账户" Style="{StaticResource FieldLabel}" Margin="0,2,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="添加" Command="{Binding AddOfflineAccountCommand}" Style="{StaticResource OutlineButton}"/>
                    </Grid>

                    <Separator Margin="0,14"/>

                    <TextBlock Text="微软账号 (Microsoft)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="开始微软登录" Command="{Binding MicrosoftBeginCommand}" Margin="0,0,8,0"
                                Style="{StaticResource OutlineButton}"/>
                        <Button Command="{Binding MicrosoftCompleteCommand}"
                                Content="{Binding MicrosoftCompleteCommand.IsRunning, Converter={StaticResource BoolToText}, ConverterParameter='登录中…|完成登录'}"
                                Style="{StaticResource OutlineButton}"/>
                    </StackPanel>
                    <!-- 未配置 Azure 应用 ID 时的引导提示（点击"开始微软登录"也会显示完整步骤） -->
                    <TextBlock Text="{Binding MicrosoftLoginHint}" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding MicrosoftMessage}" TextWrapping="Wrap" Style="{StaticResource FieldLabel}"/>
                </StackPanel>
            </Border>

            <!-- Instances -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                <StackPanel>
                    <TextBlock Text="实例" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                    <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" MaxHeight="270" Margin="0,0,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                                        <Run Text="{Binding MinecraftVersion}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding LoaderType}"/>
                                        <Run Text="{Binding LoaderVersion, StringFormat=' ({0})'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="{Binding LaunchButtonText}" Command="{Binding LaunchCommand}"
                            FontSize="14" Padding="22,10" HorizontalAlignment="Left"
                            Style="{StaticResource PillButton}"/>
                    <TextBlock Text="{Binding InstanceCardHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ======== 性能概览（round-79） ======== -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="性能概览" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RunVerdictLevel, StringFormat='上次运行：{0}'}" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                        <Button Content="调整内存" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                HorizontalAlignment="Right" Padding="12,5"
                                ToolTip="内存吃紧时，去设置页把最大内存调高一档"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding SystemCpuText}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="整机占用（3 秒刷新）" Style="{StaticResource FieldLabel}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="内存" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding SystemMemoryText}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding SystemLoadNote}" Style="{StaticResource FieldLabel}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="上次运行" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding RunPerfText}" FontSize="12.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding RunVerdictText}" Style="{StaticResource FieldLabel}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
