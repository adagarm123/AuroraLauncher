<UserControl x:Class="AuroraLauncher.Desktop.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: list -->
        <Grid Grid.Column="0" Margin="0,0,9,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="实例管理" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="管理本机所有游戏实例，支持多版本隔离与导入。" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,12">
                <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="★" Foreground="{DynamicResource WarningBrush}" Margin="7,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                                    <Run Text="{Binding MinecraftVersion}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding LoaderType}"/>
                                    <Run Text="{Binding Category, Mode=OneWay, StringFormat=' · {0}', TargetNullValue=''}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2">
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="新建实例" Command="{Binding CreateInstanceCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                    <Button Content="删除实例" Command="{Binding DeleteSelectedInstanceCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                    <Button Content="导入 .minecraft" Command="{Binding ImportMinecraftCommand}" Margin="0,0,8,8"/>
                    <Button Content="导入其他启动器" Command="{Binding ImportLauncherCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="删除仅作用于实例目录，绝不触碰其他实例或共享资源；导入为复制式，不会修改源数据。"
                           Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Right: details (PCL-style: personalization / shortcuts / advanced) -->
        <Grid Grid.Column="1" Margin="9,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: icon + name + subtitle -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="10" Background="{DynamicResource InputBgBrush}">
                    <Grid>
                        <TextBlock Text="A" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedInstanceIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding SelectedInstanceIcon}" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedInstance.Name, TargetNullValue=未选择实例}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="★" Foreground="{DynamicResource WarningBrush}" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedInstance.Favorite}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PageSubtitle}">
                        <Run Text="MC "/>
                        <Run Text="{Binding SelectedInstance.MinecraftVersion, Mode=OneWay, TargetNullValue=-}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding SelectedInstance.LoaderType, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 个性化 -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="个性化" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="图标" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding IconChoiceOptions}"
                                          SelectedValue="{Binding SelectedInstanceIconChoice, Mode=TwoWay}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="分类" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding CategoryOptions}"
                                          Text="{Binding SelectedInstanceCategory, UpdateSourceTrigger=LostFocus}"
                                          ToolTip="可选预设分类，也可输入自定义分类名"/>
                            </Grid>
                            <WrapPanel>
                                <Button Content="修改版本名" Command="{Binding RenameInstanceCommand}" Margin="0,0,8,8"/>
                                <Button Content="修改版本描述" Command="{Binding EditNotesCommand}" Margin="0,0,8,8"/>
                                <Button Content="{Binding SelectedInstanceFavoriteText}" Command="{Binding ToggleFavoriteCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 快捷方式 -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="快捷方式" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="版本文件夹" Command="{Binding OpenInstanceFolderCommand}" Margin="0,0,8,8"/>
                                <Button Content="存档文件夹" Command="{Binding OpenSavesFolderCommand}" Margin="0,0,8,8"/>
                                <Button Content="Mod 文件夹" Command="{Binding OpenModsFolderCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 高级管理 -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="高级管理" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="导出启动脚本" Command="{Binding ExportLaunchScriptCommand}" Margin="0,0,8,8"
                                        ToolTip="导出可直接双击运行的 .bat 启动脚本（含登录令牌，请妥善保管）"/>
                                <Button Content="补全文件" Command="{Binding RepairInstanceCommand}" Margin="0,0,8,8"
                                        ToolTip="扫描并补全缺失的游戏文件"/>
                                <Button Content="删除版本" Command="{Binding DeleteSelectedInstanceCommand}" Style="{StaticResource DangerButton}"
                                        ToolTip="删除该实例（未引用的版本文件会自动清理）"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 目录 -->
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="实例目录" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="10,8">
                                <TextBlock Text="{Binding SelectedInstance.Directory}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
