<UserControl x:Class="AuroraLauncher.Desktop.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: list -->
        <Grid Grid.Column="0" Margin="0,0,9,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="实例管理" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="管理本机所有游戏实例，支持多版本隔离与导入。" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,12">
                <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="★" Foreground="{DynamicResource WarningBrush}" Margin="7,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                                    <Run Text="{Binding MinecraftVersion}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding LoaderType}"/>
                                    <Run Text="{Binding Category, Mode=OneWay, StringFormat=' · {0}', TargetNullValue=''}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2">
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="新建实例" Command="{Binding CreateInstanceCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                            ToolTip="去「游戏下载」选版本安装；装完自动出现在这里"/>
                    <Button Content="删除实例" Command="{Binding DeleteSelectedInstanceCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"
                            ToolTip="删除该实例的整个文件夹（含存档/模组）以及列表记录"/>
                    <Button Command="{Binding ScanInstancesCommand}"
                            Content="{Binding ScanInstancesCommand.IsRunning, Converter={StaticResource BoolToText}, ConverterParameter='扫描中…|扫描未注册实例'}" Margin="0,0,8,8"
                            ToolTip="对比列表与 instances 文件夹：找回未登记的实例、清理已丢失的死链；陌生文件夹只会报告，不会改动"/>
                    <Button Content="导入 .minecraft" Command="{Binding ImportMinecraftCommand}" Margin="0,0,8,8"/>
                    <Button Content="导入其他启动器" Command="{Binding ImportLauncherCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="删除会移除整个实例文件夹（不可恢复）；导入为复制式，不会修改源数据。「扫描未注册实例」只比对、只加记录，不会删除任何文件夹。"
                           Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Right: details (PCL-style: personalization / shortcuts / advanced) -->
        <Grid Grid.Column="1" Margin="9,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: icon + name + subtitle -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="10" Background="{DynamicResource InputBgBrush}">
                    <Grid>
                        <TextBlock Text="A" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedInstanceIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding SelectedInstanceIcon}" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedInstance.Name, TargetNullValue=未选择实例}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="★" Foreground="{DynamicResource WarningBrush}" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedInstance.Favorite}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PageSubtitle}">
                        <Run Text="MC "/>
                        <Run Text="{Binding SelectedInstance.MinecraftVersion, Mode=OneWay, TargetNullValue=-}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding SelectedInstance.LoaderType, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 个性化 -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="个性化" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="图标" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding IconChoiceOptions}"
                                          SelectedValue="{Binding SelectedInstanceIconChoice, Mode=TwoWay}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="分类" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding CategoryOptions}"
                                          Text="{Binding SelectedInstanceCategory, UpdateSourceTrigger=LostFocus}"
                                          ToolTip="可选预设分类，也可输入自定义分类名"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Java" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding InstanceJavaChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Path"
                                          SelectedValue="{Binding SelectedInstanceJavaPath, Mode=TwoWay}"
                                          ToolTip="给这个实例单独指定 Java；选「自动选择」则跟随全局设置和游戏版本需求"/>
                            </Grid>
                            <TextBlock Text="{Binding InstanceJavaHint}" Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="修改版本名" Command="{Binding RenameInstanceCommand}" Margin="0,0,8,8"/>
                                <Button Content="修改版本描述" Command="{Binding EditNotesCommand}" Margin="0,0,8,8"/>
                                <Button Content="{Binding SelectedInstanceFavoriteText}" Command="{Binding ToggleFavoriteCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 游玩统计（round-77） -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="游玩统计" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SelectedInstance.PlayStatsText, TargetNullValue=还没有游玩记录}"
                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedInstance.LastPlayedText}" Style="{StaticResource FieldLabel}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="启动器在游戏进程启动/退出时记录；若启动器被强制结束，下次启动会按最后一次心跳补记（最多一分钟误差）。"
                                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 存档备份（round-79） -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="存档备份" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自动备份" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SaveBackupModeOptions}"
                                          SelectedItem="{Binding SaveBackupText, Mode=TwoWay}"
                                          ToolTip="启动前备份最安全（游戏还没碰存档）；退出后备份不拖慢启动"/>
                                <TextBlock Grid.Column="2" Text="保留" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="12,0,8,0"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding SaveBackupKeepOptions}"
                                          SelectedItem="{Binding SaveBackupKeepText, Mode=TwoWay}" MinWidth="80"/>
                            </Grid>
                            <TextBlock Text="{Binding BackupInfoText}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SaveBackupNote}" Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap" Margin="0,6,0,10"/>
                            <WrapPanel>
                                <Button Content="立即备份" Command="{Binding BackupSavesNowCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                                <Button Content="打开备份文件夹" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 快捷方式 -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="快捷方式" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="版本文件夹" Command="{Binding OpenInstanceFolderCommand}" Margin="0,0,8,8"/>
                                <Button Content="存档文件夹" Command="{Binding OpenSavesFolderCommand}" Margin="0,0,8,8"/>
                                <Button Content="Mod 文件夹" Command="{Binding OpenModsFolderCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 高级管理 -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="高级管理" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="导出整合包 (.mrpack)" Command="{Binding ExportMrpackCommand}" Margin="0,0,8,8"
                                        ToolTip="把模组与配置打包成 .mrpack：Modrinth 已收录的模组只写下载链接，朋友拖进启动器即可安装"/>
                                <Button Content="导入整合包" Command="{Binding ImportMrpackCommand}" Margin="0,0,8,8"
                                        ToolTip="选择本地 .mrpack，自动按包内声明的版本与加载器创建实例并安装"/>
                                <Button Content="导出启动脚本" Command="{Binding ExportLaunchScriptCommand}" Margin="0,0,8,8"
                                        ToolTip="导出可直接双击运行的 .bat 启动脚本（含登录令牌，请妥善保管）"/>
                                <Button Command="{Binding RepairInstanceCommand}"
                                        Content="{Binding RepairInstanceCommand.IsRunning, Converter={StaticResource BoolToText}, ConverterParameter='补全中…|补全文件'}" Margin="0,0,8,8"
                                        ToolTip="扫描并补全缺失的游戏文件（加载器未装完、整合包模组缺失都靠这个补）"/>
                                <Button Content="删除实例（含文件）" Command="{Binding DeleteSelectedInstanceCommand}" Style="{StaticResource DangerButton}"
                                        ToolTip="删除整个实例文件夹（存档/模组/配置）+ 列表记录；先删文件，失败则保留记录并提示原因"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 目录 -->
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="实例目录" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="10,8">
                                <TextBlock Text="{Binding SelectedInstance.Directory}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
