<Window x:Class="AuroraLauncher.Desktop.Views.UpdateApplyingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="正在应用更新" Height="230" Width="460"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <!-- Round-61: this window IS the update. The old hidden cmd script left
         the screen blank for 10+ seconds while it copied a 63 MB exe, which
         looked exactly like a crash. Every stage is now visible, and any
         failure shows a message + a retry button instead of silence. -->
    <Border BorderBrush="#3A3E58" BorderThickness="1" CornerRadius="12" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="正在应用更新并重启…" FontSize="21" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Margin="0,8,0,18" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="新版本正在安装，通常只需几秒。请勿关闭电脑或断开电源。"/>

            <TextBlock x:Name="StageText" Grid.Row="2" Text="正在等待旧版本退出…"
                       FontSize="13.5" Margin="0,0,0,10"/>
            <ProgressBar x:Name="Progress" Grid.Row="3" Height="8" Minimum="0" Maximum="100" Value="8"/>

            <StackPanel x:Name="ErrorPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock x:Name="ErrorText" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="#FF8A8A" LineHeight="20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="重试" Click="Retry_Click" Style="{StaticResource PrimaryButton}" Padding="18,7"/>
                    <Button Content="关闭" Click="Close_Click" Padding="18,7" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
