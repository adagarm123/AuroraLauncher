<Window x:Class="AuroraLauncher.Desktop.Views.PreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动前检查" Width="560" SizeToContent="Height" MaxHeight="620"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="启动前检查发现模组问题" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="HeadlineText" FontSize="12.5" Margin="0,6,0,0"
                       Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="这些问题通常会让游戏启动后立刻崩溃。可以先修好再启动，也可以忽略提示直接进入游戏。"
                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <StackPanel>
                <ItemsControl x:Name="IssueList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="7" Background="{DynamicResource PanelAltBrush}" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <!-- Round-100: missing prerequisites can be ticked for one-click repair -->
                                    <CheckBox Content="自动补齐这一项" IsChecked="{Binding IsChecked}"
                                              FontSize="11" Margin="16,3,0,0">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanFix}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TruncatedText" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="2,2,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消启动" Click="Cancel_Click" Padding="16,7" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="仍然启动" Click="Launch_Click" Padding="16,7" Margin="0,0,8,0"/>
            <Button x:Name="AutoFixButton" Content="补齐选中项并继续" Click="AutoFix_Click"
                    Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,8,0"/>
            <Button x:Name="InstallButton" Content="安装 Fabric API 并继续" Click="Install_Click"
                    Style="{StaticResource PrimaryButton}" Padding="16,7"/>
        </StackPanel>
    </Grid>
</Window>
