<UserControl x:Class="AuroraLauncher.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Margin="24">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="调整内存、Java、下载源与代理等启动器行为。" Style="{StaticResource PageSubtitle}" Margin="0,2,0,18"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="存储" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="游戏文件储存目录（versions / libraries / assets / instances）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RootDirectoryText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsRootDirectoryEditable}" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="打开文件夹" Command="{Binding OpenRootDirectoryCommand}"
                                ToolTip="在资源管理器中打开该目录（不存在时会自动创建）"/>
                    </Grid>
                    <TextBlock Text="修改后需重启启动器生效；已有文件不会自动迁移，新目录将按需重新下载。"
                               Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>

                    <TextBlock Text="便携模式（U 盘 / 移动硬盘）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding PortableModeText}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" LineHeight="18"/>
                    <Button Content="创建 portable.txt（下次启动生效）" Command="{Binding EnablePortableModeCommand}"
                            Padding="14,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding IsRootDirectoryEditable, Converter={StaticResource BoolToVis}}"
                            ToolTip="在启动器所在目录放一个 portable.txt，配置 / 实例 / 缓存都改存到该目录；已有数据不会自动搬移"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>

                    <!-- Round-87: 用户可控的磁盘回收入口：断点续传留下的 .part
                         与 update/ 里的更新残留，一个按钮说清楚释放了多少 -->
                    <TextBlock Text="下载残留（断点续传的临时文件 / 未完成的更新包）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="清理残留下载文件" Command="{Binding CleanResidueCommand}"
                                Padding="14,6" ToolTip="删除未完成的 .part 与 update/ 中的旧更新包；正在下载的文件不会被删"/>
                        <TextBlock Text="正在清理…" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Visibility="{Binding IsCleaningResidue, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ResidueStatusText}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding ResidueStatusText, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="正在下载的文件不会被清理；如果某个文件还能在「下载管理」里继续，清理前会先询问。"
                               Style="{StaticResource FieldLabel}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>

                    <!-- Round-88: 扫描整个数据目录，按分类勾选清理。
                         交互与第 84 轮「扫描未注册实例」一致：先扫描、后确认、如实报告 -->
                    <TextBlock Text="垃圾缓存（扫描后选择性清理）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding StorageScanButtonText}" Command="{Binding ScanStorageCleanupCommand}"
                                Padding="14,6" ToolTip="扫描图标缓存、OptiFine 缓存、旧日志、无主残片、空壳版本目录等；只统计，不删除"/>
                        <Button Content="{Binding StorageCleanButtonText}" Command="{Binding ApplyStorageCleanupCommand}"
                                Padding="14,6" Margin="8,0,0,0" ToolTip="只删除勾选的项目；正在下载的文件不会被删"/>
                    </StackPanel>

                    <!-- 清理可能涉及上万个文件：不确定态进度条 + 按钮文案切换，避免"点了没反应" -->
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanningStorage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCleaningStorage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock Text="{Binding StorageCleanupSummary}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding StorageCleanupSummary, Converter={StaticResource NullToCollapsed}}"/>

                    <ItemsControl ItemsSource="{Binding StorageCleanupGroups}" Margin="0,6,0,0"
                                  IsEnabled="{Binding CanEditStorageSelection}"
                                  Visibility="{Binding HasStorageCleanupReport, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,4,0,0"
                                          Content="{Binding Label}" ToolTip="{Binding Description}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StorageCleanupSelectionText}" Style="{StaticResource FieldLabel}"
                               Margin="0,8,0,0"
                               Visibility="{Binding StorageCleanupSelectionText, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="{Binding StorageCleanupResult}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding StorageCleanupResult, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="{Binding StorageCleanupHint}"
                               Style="{StaticResource FieldLabel}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <!-- 两个清理入口的分工（第 88 轮复核）：这里必须说清，否则用户会问"这两个按钮有什么区别" -->
                    <TextBlock Text="上面「清理残留下载文件」只处理下载残渣（未完成的 .part 与更新包残片）；这里会扫描整个存储目录，把图标/安装器/清单缓存、旧日志、空壳版本目录一起列出来。"
                               Style="{StaticResource FieldLabel}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Java 环境" Style="{StaticResource CardTitle}"/>
                        <Button Grid.Column="1" Content="重新检测" Command="{Binding ReloadJavaListCommand}" Padding="10,4"/>
                    </Grid>
                    <!-- MaxHeight keeps this list's own scrolling bounded: an
                         unbounded list inside the page ScrollViewer would kill
                         virtualization and double-scroll. -->
                    <ListBox ItemsSource="{Binding JavaList}" MinHeight="60" MaxHeight="220" Margin="0,0,0,4"
                             PreviewMouseWheel="JavaList_PreviewMouseWheel"
                             ToolTip="滚轮滚动到列表边缘时会继续滚动整页">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="使用" Padding="12,4" VerticalAlignment="Center" Margin="10,0,0,0"
                                            Command="{Binding DataContext.UseJavaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="MC 1.17+ 需要 Java 16 及以上；留空 Java 路径时启动器会自动选择合适的运行时。"
                               Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>

                    <!-- 一键安装 Java 21（round-59）：后台下载 + SHA-256 校验 + 静默解压 + 自动设为默认 -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="一键安装 Java 21" Command="{Binding InstallJava21Command}"
                                Style="{StaticResource PrimaryButton}" Padding="16,7"/>
                        <TextBlock Text="从 Adoptium 官方源下载，自动校验并设为默认 Java（不改动系统环境变量）"
                                   Style="{StaticResource FieldLabel}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="380"/>
                    </StackPanel>
                    <TextBlock Text="{Binding JavaInstallStatus}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <ProgressBar Value="{Binding JavaInstallProgress}" Maximum="100" Height="6" Margin="0,6,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstallingJava}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <!-- 一键诊断包：报 bug 时附上即可，省去十轮问答 -->
                    <Button Content="导出诊断包" Command="{Binding ExportDiagnosticsCommand}" Padding="10,4"
                            HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="游戏" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="内存分配" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <!-- Round-83: 自动分配（推荐）—— 按物理内存 + 模组数量 + 光影算 -->
                    <CheckBox Content="自动（推荐）：按物理内存、模组数量与光影计算"
                              IsChecked="{Binding AutoMemory}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}" Width="180"
                             HorizontalAlignment="Left" IsEnabled="{Binding MemoryManualEnabled}"/>
                    <TextBlock Text="{Binding MemoryAutoHint}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding MemoryWarningText}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                               Visibility="{Binding HasMemoryWarning, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="释放启动器占用内存" Command="{Binding DeepCleanMemoryCommand}"
                                IsEnabled="{Binding CanCleanMemory}" Padding="10,4"
                                ToolTip="只清理启动器自己的图标缓存并回收本进程工作集；不会碰游戏（Java）进程，也不会清系统内存"/>
                        <TextBlock Text="{Binding MemoryCleanStatus}" FontSize="11.5" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <CheckBox Content="最小化到托盘 5 分钟后自动释放启动器缓存（不影响游戏）"
                              IsChecked="{Binding ReleaseIdleMemory}" Margin="0,10,0,0"/>

                    <TextBlock Text="Java 路径（留空则自动检测）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="游戏窗口分辨率" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding WindowW, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Text="{Binding WindowH, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>

                    <TextBlock Text="额外 JVM 参数" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding ExtraJvm, UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox Content="安装 Fabric 实例时自动安装适配的 Fabric API 前置"
                              IsChecked="{Binding AutoInstallFabricApi}" Margin="0,16,0,0"
                              ToolTip="大多数 Fabric Mod 依赖 Fabric API；开启后安装 Fabric 实例/模组时会自动安装适配当前 MC 版本的 Fabric API（关闭则改为弹窗询问）"/>
                    <CheckBox Content="启动前检查模组依赖与冲突" IsChecked="{Binding CheckModsBeforeLaunch}" Margin="0,12,0,0"
                              ToolTip="扫描 mods 文件夹里每个模组声明的依赖 / 冲突 / 重复项；发现问题时在启动前提示，可一键补装 Fabric API"/>
                    <TextBlock Text="关闭后安装 Fabric 实例或 Fabric 模组时会弹窗询问是否安装 Fabric API。"
                               Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="网络" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="下载线路" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding DownloadSourceOptions}" SelectedValue="{Binding DownloadPolicyText}"
                              Width="300" HorizontalAlignment="Left"
                              ToolTip="自动：两条线路都参与，优先测速更快的一条，失败自动换另一条；也可以强制只走某一条"/>
                    <!-- 测速结果 + 当前策略（实时计算，不是写死的字符串） -->
                    <TextBlock Text="{Binding NetworkNoteDisplay}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                               Visibility="{Binding NetworkNoteDisplay, Converter={StaticResource NullToCollapsed}}"/>

                    <TextBlock Text="代理地址（可选，如 http://127.0.0.1:7890）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="微软登录 Client ID（可选，Azure 应用注册的客户端 ID）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding MicrosoftClientIdText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="portal.azure.com → 应用注册 →「应用程序(客户端) ID」；需启用「允许公共客户端流」"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                    <Button Content="切换深色 / 浅色主题" Command="{Binding SwitchThemeCommand}" HorizontalAlignment="Left"/>

                    <!-- Round-80: 液态玻璃（默认关闭；开启前有红色性能警告） -->
                    <TextBlock Text="界面材质（液态玻璃）" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <ComboBox ItemsSource="{Binding GlassModeOptions}" SelectedItem="{Binding GlassModeText, Mode=TwoWay}"
                              Width="340" HorizontalAlignment="Left"
                              ToolTip="默认「关闭」= 原主题。选择任何玻璃方案都会先弹出红色性能警告，确认后才生效"/>
                    <TextBlock Text="{Binding GlassNote}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="窗口与托盘" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="关闭窗口时" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding CloseActionOptions}" SelectedItem="{Binding CloseActionText}"
                              Width="320" HorizontalAlignment="Left"
                              ToolTip="点右上角 × 时的行为。只要还有下载在跑，「直接退出」也会先弹窗确认，不会静默中断"/>
                    <TextBlock Text="选「直接退出」时，只要还有下载在跑，关闭窗口（含托盘菜单里的退出）仍会先弹窗确认，不会静默中断任务。每次询问我 = 弹窗让你选「退出 / 最小化到托盘」并可勾选记住；最小化到托盘 = 点 × 直接收起，下载继续。"
                               Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <CheckBox Content="启用托盘图标" IsChecked="{Binding TrayEnabled}" Margin="0,14,0,0"
                              ToolTip="关闭后没有托盘入口，「最小化到托盘」会自动降级为「询问」"/>
                    <TextBlock Text="{Binding TrayNote}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="隐藏到托盘时启动器会停下来不做的：空闲页面预热、界面数值刷新（降到每秒 1 次）。下载与安装照常进行。"
                               Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="更新" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="更新方式" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding UpdateModeOptions}" SelectedValue="{Binding UpdateModeText}"
                              Width="320" HorizontalAlignment="Left"
                              ToolTip="1 自动更新：启动检查并后台下载；2 发现新版本时弹窗，由你决定是否更新；3 不获取更新：启动时不检查"/>
                    <TextBlock Text="自动更新：后台下载、重启生效；提醒但不自动更新：发现新版本弹窗（立即更新 / 关闭）；不获取更新：启动时不检查，手动检查仍可用。"
                               Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <TextBlock Text="更新源地址（留空使用内置地址）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding UpdateFeedUrlText, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Command="{Binding CheckUpdateCommand}"
                                Content="{Binding CheckUpdateCommand.IsRunning, Converter={StaticResource BoolToText}, ConverterParameter='检查中…|检查更新'}"
                                Style="{StaticResource PrimaryButton}" Padding="16,7"/>
                        <Button Content="立即重启并应用更新" Command="{Binding RestartToApplyCommand}"
                                Visibility="{Binding StagedUpdateReady, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="10,0,0,0"/>
                        <TextBlock Text="手动检查不受上面开关限制；下载时会显示进度、速度和已下载大小"
                                   Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="6" Margin="0,8,0,0"
                                 IsIndeterminate="{Binding UpdateProgressIndeterminate}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="保存设置" Command="{Binding ApplySettingsCommand}" Style="{StaticResource PrimaryButton}"
                        Padding="20,9" VerticalAlignment="Center"/>
                <!-- Round-90: 改完就走的用户不该靠"记不记得点保存"来决定设置是否生效 -->
                <TextBlock Text="{Binding SettingsDirtyHint}" FontSize="11.5" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"
                           Foreground="{DynamicResource WarningBrush}"
                           Visibility="{Binding HasSettingsDirtyHint, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
