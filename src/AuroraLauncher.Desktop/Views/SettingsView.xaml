<UserControl x:Class="AuroraLauncher.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Margin="24">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="调整内存、Java、下载源与代理等启动器行为。" Style="{StaticResource PageSubtitle}" Margin="0,2,0,18"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="存储" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="游戏文件储存目录（versions / libraries / assets / instances）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RootDirectoryText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="打开文件夹" Command="{Binding OpenRootDirectoryCommand}"
                                ToolTip="在资源管理器中打开该目录（不存在时会自动创建）"/>
                    </Grid>
                    <TextBlock Text="修改后需重启启动器生效；已有文件不会自动迁移，新目录将按需重新下载。"
                               Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Java 环境" Style="{StaticResource CardTitle}"/>
                        <Button Grid.Column="1" Content="重新检测" Command="{Binding ReloadJavaListCommand}" Padding="10,4"/>
                    </Grid>
                    <!-- MaxHeight keeps this list's own scrolling bounded: an
                         unbounded list inside the page ScrollViewer would kill
                         virtualization and double-scroll. -->
                    <ListBox ItemsSource="{Binding JavaList}" MinHeight="60" MaxHeight="220" Margin="0,0,0,4"
                             PreviewMouseWheel="JavaList_PreviewMouseWheel"
                             ToolTip="滚轮滚动到列表边缘时会继续滚动整页">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="使用" Padding="12,4" VerticalAlignment="Center" Margin="10,0,0,0"
                                            Command="{Binding DataContext.UseJavaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="MC 1.17+ 需要 Java 16 及以上；留空 Java 路径时启动器会自动选择合适的运行时。"
                               Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>

                    <!-- 一键诊断包：报 bug 时附上即可，省去十轮问答 -->
                    <Button Content="导出诊断包" Command="{Binding ExportDiagnosticsCommand}" Padding="10,4"
                            HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="游戏" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="内存分配 (MB)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left"/>

                    <TextBlock Text="Java 路径（留空则自动检测）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="游戏窗口分辨率" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding WindowW, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Text="{Binding WindowH, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>

                    <TextBlock Text="额外 JVM 参数" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding ExtraJvm, UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox Content="安装 Fabric 实例时自动安装适配的 Fabric API 前置"
                              IsChecked="{Binding AutoInstallFabricApi}" Margin="0,16,0,0"
                              ToolTip="大多数 Fabric Mod 依赖 Fabric API；开启后安装 Fabric 实例/模组时会自动安装适配当前 MC 版本的 Fabric API（关闭则改为弹窗询问）"/>
                    <TextBlock Text="关闭后安装 Fabric 实例或 Fabric 模组时会弹窗询问是否安装 Fabric API。"
                               Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="网络" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="下载源" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding DownloadSourceOptions}" SelectedValue="{Binding DownloadSourceText}" Width="220" HorizontalAlignment="Left"/>
                    <!-- 网络环境自动感知结果（启动探测写入，仅提示不拦截手动修改） -->
                    <TextBlock Text="{Binding NetworkNoteDisplay}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                               Visibility="{Binding NetworkNoteDisplay, Converter={StaticResource NullToCollapsed}}"/>

                    <TextBlock Text="代理地址（可选，如 http://127.0.0.1:7890）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="微软登录 Client ID（可选，Azure 应用注册的客户端 ID）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding MicrosoftClientIdText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="portal.azure.com → 应用注册 →「应用程序(客户端) ID」；需启用「允许公共客户端流」"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                    <Button Content="切换深色 / 浅色主题" Command="{Binding SwitchThemeCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="更新" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="更新方式" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding UpdateModeOptions}" SelectedValue="{Binding UpdateModeText}"
                              Width="320" HorizontalAlignment="Left"
                              ToolTip="1 自动更新：启动检查并后台下载；2 发现新版本时弹窗，由你决定是否更新；3 不获取更新：启动时不检查"/>
                    <TextBlock Text="自动更新：后台下载、重启生效；提醒但不自动更新：发现新版本弹窗（立即更新 / 关闭）；不获取更新：启动时不检查，手动检查仍可用。"
                               Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <TextBlock Text="更新源地址（留空使用内置地址）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding UpdateFeedUrlText, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="检查更新" Command="{Binding CheckUpdateCommand}" Style="{StaticResource PrimaryButton}" Padding="16,7"/>
                        <TextBlock Text="手动检查不受上面开关限制" Style="{StaticResource FieldLabel}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="6" Margin="0,8,0,0"
                                 IsIndeterminate="{Binding UpdateProgressIndeterminate}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <Button Content="保存设置" Command="{Binding ApplySettingsCommand}" Style="{StaticResource PrimaryButton}"
                    Padding="20,9" HorizontalAlignment="Left" Margin="0,0,0,24"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
