<Window x:Class="AuroraLauncher.Desktop.Views.UpdateDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在下载更新" Height="262" Width="480"
        WindowStyle="ToolWindow" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <!-- Round-101: the download stage used to live only in the settings page,
         so "自动更新 / 提醒并更新" looked like the launcher had frozen. This
         window owns the visible progress and the honest cancel path. -->
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="Bold"
                       Text="{Binding UpdateWindowTitle}"/>
            <TextBlock Grid.Row="1" Margin="0,10,0,18" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="下载完成后会先暂存更新包，再打开安装进度窗口。你可以随时取消下载，不会安装半个文件。"/>

            <TextBlock Grid.Row="2" Text="{Binding UpdateStatusText}" FontSize="13.5" Margin="0,0,0,10"
                       TextWrapping="Wrap"/>
            <ProgressBar Grid.Row="3" Height="10" Minimum="0" Maximum="100"
                         Value="{Binding UpdateProgress}"
                         IsIndeterminate="{Binding UpdateProgressIndeterminate}"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                <TextBlock x:Name="HintText" FontSize="11" TextWrapping="Wrap" MaxWidth="270"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <Button Content="取消下载" Command="{Binding CancelUpdateCommand}"
                        Padding="16,7" MinWidth="92"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
