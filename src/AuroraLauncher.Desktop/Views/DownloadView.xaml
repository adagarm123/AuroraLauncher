<UserControl x:Class="AuroraLauncher.Desktop.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== 左侧：版本选择 ======== -->
        <Grid Grid.Column="0" Margin="0,0,9,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="游戏下载" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="选择游戏版本，在右侧配置加载器后安装。" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Text="{Binding VersionSearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,0"
                         ToolTip="输入关键词实时过滤版本"/>
                <ComboBox ItemsSource="{Binding VersionFilterOptions}" SelectedValue="{Binding VersionFilter}" Width="120" Margin="0,0,10,0"/>
                <Button Content="刷新" Command="{Binding RefreshVersionsCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="9" Padding="9,2" Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="release">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Type}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="release">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ======== 右侧：安装新游戏（PCL 风格加载器卡片） ======== -->
        <Grid Grid.Column="1" Margin="9,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 实例名称 -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="游戏实例名称" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding NewInstanceName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>

            <!-- 加载器卡片 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Minecraft（主卡，固定显示所选版本） -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="MC" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Minecraft" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="{Binding SelectedVersion.Id, Mode=OneWay, TargetNullValue=请先在左侧选择版本}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 加载器卡片 -->
                    <ItemsControl ItemsSource="{Binding LoaderCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,10,10"
                                        Opacity="{Binding CanSelect, Converter={StaticResource BoolToOpacity}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Short}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  MinWidth="150" Margin="0,8,0,0"
                                                  ToolTip="一个实例只能安装一个模组加载器；选择「不安装」表示不安装此加载器"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasVersion}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 暂不支持 / 自动项 -->
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,10,10" Opacity="0.55">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource ChipBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="OF" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="OptiFine" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="暂不支持" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10" Opacity="0.8">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="FA" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Fabric API" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="选择 Fabric 加载器后自动安装适配版本（可在设置中关闭）" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- 安装按钮 -->
            <Button Grid.Row="2" Content="安 装" Command="{Binding InstallFromCardsCommand}" Style="{StaticResource PrimaryButton}"
                    FontSize="16" FontWeight="Bold" Padding="40,11" Margin="0,12,0,0"
                    ToolTip="安装所选版本与加载器（全部选「不安装」= 纯原版）"/>
        </Grid>
    </Grid>
</UserControl>
