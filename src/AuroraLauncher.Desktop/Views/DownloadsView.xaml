<UserControl x:Class="AuroraLauncher.Desktop.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <!-- Stage marker: percent while running, check when done -->
        <Style x:Key="StageMarker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StageLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== 左侧统计（总进度 / 速度 / 剩余文件） ======== -->
        <Border Grid.Column="0" Margin="0,0,14,0">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,0,26">
                    <TextBlock Text="总进度" Style="{StaticResource StatLabel}"/>
                    <Separator Margin="14,8,14,0" Width="130"/>
                    <TextBlock Style="{StaticResource StatValue}" HorizontalAlignment="Center">
                        <Run Text="{Binding Download.Percent, Mode=OneWay}"/>
                        <Run Text="%"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="0,0,0,26">
                    <TextBlock Text="下载速度" Style="{StaticResource StatLabel}"/>
                    <Separator Margin="14,8,14,0" Width="130"/>
                    <TextBlock Text="{Binding Download.Speed}" Style="{StaticResource StatValue}" FontSize="22"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="剩余文件" Style="{StaticResource StatLabel}"/>
                    <Separator Margin="14,8,14,0" Width="130"/>
                    <TextBlock Text="{Binding Download.Remaining}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <!-- 当前状态（重试/跳过等），有消息时显示 -->
                <TextBlock Text="{Binding Download.Detail}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}" Margin="0,14,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Download.HasDetail}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ======== 右侧安装流程图 ======== -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"
                           Text="{Binding InstallTitle, Mode=OneWay}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 安装成功横幅 -->
                        <Border CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding InstallSuccess, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding InstallSuccess}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!-- 失败原因 -->
                        <Border CornerRadius="8" Background="{DynamicResource DangerSoftBrush}" Padding="12,9" Margin="0,0,0,10"
                                Visibility="{Binding InstallError, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding InstallError}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding InstallStages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Marker}" Style="{StaticResource StageMarker}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource StageLabel}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空状态 -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstallStages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="当前没有安装任务" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,4"/>
                            <TextBlock Text="在「游戏下载」页选择版本并点击安装，或在「内容中心」安装整合包时，这里会显示安装流程。"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部动作区：运行中显示取消，完成后显示启动 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="取消下载" Command="{Binding CancelDownloadCommand}"
                            Padding="18,8" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Download.Active}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="启动游戏" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}"
                            Padding="18,8"
                            Visibility="{Binding InstallSuccess, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
