<Window x:Class="AuroraLauncher.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AuroraLauncher.Desktop"
        mc:Ignorable="d"
        Title="Aurora Launcher" Height="720" Width="1160" MinHeight="640" MinWidth="980"
        Icon="/app.ico"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Command" Value="{Binding NavigateCommand}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== Sidebar ======== -->
        <Border Grid.Column="0" Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,16,18">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentGradient}">
                        <TextBlock Text="A" FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Aurora" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="MINECRAFT LAUNCHER" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavItem}" CommandParameter="Home"
                            Background="{Binding CurrentPageKey, Converter={StaticResource PageActive}, ConverterParameter=Home}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock Text="首页" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" CommandParameter="Download"
                            Background="{Binding CurrentPageKey, Converter={StaticResource PageActive}, ConverterParameter=Download}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock Text="游戏下载" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" CommandParameter="Instances"
                            Background="{Binding CurrentPageKey, Converter={StaticResource PageActive}, ConverterParameter=Instances}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock Text="实例管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" CommandParameter="Mods"
                            Background="{Binding CurrentPageKey, Converter={StaticResource PageActive}, ConverterParameter=Mods}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock Text="内容中心" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" CommandParameter="Downloads"
                            Background="{Binding CurrentPageKey, Converter={StaticResource PageActive}, ConverterParameter=Downloads}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock Text="下载管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="14,10"/>
                    <Button Style="{StaticResource NavItem}" CommandParameter="Settings"
                            Background="{Binding CurrentPageKey, Converter={StaticResource PageActive}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" CommandParameter="Logs"
                            Background="{Binding CurrentPageKey, Converter={StaticResource PageActive}, ConverterParameter=Logs}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock Text="日志" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" CommandParameter="Changelog"
                            Background="{Binding CurrentPageKey, Converter={StaticResource PageActive}, ConverterParameter=Changelog}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock Text="更新日志" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" CommandParameter="Help"
                            Background="{Binding CurrentPageKey, Converter={StaticResource PageActive}, ConverterParameter=Help}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="?" FontSize="16" FontWeight="Bold" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="帮助" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Theme switch -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="14,8"/>
                    <Button Command="{Binding SwitchThemeCommand}" Margin="10,4,10,14" Padding="12,9"
                            Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock Text="切换主题" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- ======== Main content ======== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Download.Active}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <!-- 状态文字：按语义着色（错误红 / 成功绿 / 常规），加粗放大更醒目 -->
                        <Border CornerRadius="8" Padding="12,5" Margin="10,0,0,0"
                                Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=bg}">
                            <TextBlock Text="{Binding Status}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                        </Border>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Aurora Launcher" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Border>
                    <Grid/>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
        </Grid>

        <!-- ======== 首次启动引导浮层 ======== -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2"
              Visibility="{Binding FirstRunWizardVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgDeepBrush}" Opacity="0.97"/>
            <Border Background="Transparent" MaxWidth="620" MaxHeight="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource Card}" Padding="30,26">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="欢迎来到 Aurora Launcher" FontSize="20" FontWeight="Bold"/>
                            <Button Content="跳过引导" Command="{Binding FirstRunSkipCommand}" Padding="10,4"
                                    HorizontalAlignment="Right" Style="{StaticResource GhostButton}"/>
                        </Grid>

                        <!-- 步骤 1/3：Java 环境 -->
                        <StackPanel Visibility="{Binding FirstRunStep0Visible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="步骤 1 / 3 · 检查 Java 环境" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding FirstRunJavaStatus}" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="重新检测" Command="{Binding FirstRunRescanCommand}" Padding="14,6" Margin="0,0,10,0"/>
                                <Button Content="打开 Java 下载页（Adoptium）" Command="{Binding FirstRunOpenJavaSiteCommand}" Padding="14,6"
                                        Style="{StaticResource GhostButton}"/>
                                <Button Content="下一步" Command="{Binding FirstRunNextCommand}" Padding="18,6"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 步骤 2/3：推荐版本一键安装 -->
                        <StackPanel Visibility="{Binding FirstRunStep1Visible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="步骤 2 / 3 · 安装推荐版本" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding FirstRunRecommendation}" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding FirstRunProgress}" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="一键安装" Command="{Binding FirstRunInstallCommand}" Padding="18,6"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                        IsEnabled="{Binding FirstRunInstallEnabled}"/>
                                <Button Content="稍后再说" Command="{Binding FirstRunSkipCommand}" Padding="14,6"
                                        Style="{StaticResource GhostButton}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 步骤 3/3：完成 -->
                        <StackPanel Visibility="{Binding FirstRunStep2Visible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="就绪！" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock Text="推荐版本已安装完成。选择实例后点击「启动游戏」即可游玩；更多版本与 Mod 请到「游戏下载」「内容中心」。"
                                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>
                            <Button Content="完成" Command="{Binding FirstRunDoneCommand}" Padding="18,6"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- 全局非阻塞 Toast（8 秒自动消失）：自动安装前置等"需要知情但不打断"的通知 -->
            <Border Style="{StaticResource Card}" Padding="14,10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,46" MaxWidth="430" Panel.ZIndex="99" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10"
                    Visibility="{Binding ToastMessage, Converter={StaticResource NullToCollapsed}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" FontSize="12.5" MaxWidth="380"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
